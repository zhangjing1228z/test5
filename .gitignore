```gitignore
# Compiled Java files
*.class

# Package manager directories
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Build artifacts
dist/
build/

# Dependency caches
.gradle/
.mypy_cache/
.pytest_cache/
__pycache__/
```