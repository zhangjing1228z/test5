```gitignore
# Compiled Java files
*.class

# Package manager directories
node_modules/

# Virtual environments
venv/
.venv/
__pycache__/

# Build directories
build/
dist/
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Environment files
.env
.env.local
*.env.*

# OS files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python cache
.mypy_cache/
.pytest_cache/

# Gradle
.gradle/

# Zip files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```