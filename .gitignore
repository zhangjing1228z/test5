```gitignore
# Compiled files
*.class

# Dependencies
lib/
libs/
jars/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
target/
out/

# Python cache (if any Python files present)
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js (if any JS files present)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db
```